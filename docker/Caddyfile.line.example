# Merge this site block into the existing host Caddyfile.
hermes.salepie.online {
    handle /api/line/webhook {
        reverse_proxy 127.0.0.1:18080
    }

    handle {
        reverse_proxy localhost:8646
    }
}

# Add DNS for this hostname first. Preserve the existing Hermes site above.
admin.salepie.online {
    reverse_proxy 127.0.0.1:18081
}
