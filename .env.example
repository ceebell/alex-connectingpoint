# Copy to .env and edit.   cp .env.example .env   (Linux)   |   copy .env.example .env   (Windows)
# NEVER commit the real .env

# ---------- App ----------
APP_NAME=myapp

# ---------- Local frontend with Ubuntu backend (SSH key access required) ----------
# Set remote to make runall.bat start only the frontend and an SSH tunnel.
DEV_BACKEND_MODE=local
DEV_SSH_HOST=Hermes
DEV_TUNNEL_PORT=28080
DEV_REMOTE_PORT=18080
DEV_FRONTEND_PORT=3000

# ---------- Backend (Rust axum) ----------
PORT=8080
RUST_LOG=info
# Browser origin allowed by CORS. Leave empty to disable the CORS layer (the frontend proxies /api, so it is optional)
CORS_ORIGIN=http://localhost:3000

# ---------- MongoDB ----------
# Dev: local mongod, no auth
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=myapp

# ---------- LINE inquiry intake (one trusted shop/channel per deployment) ----------
# Values are required. Get the destination bot user ID from LINE Developers.
LINE_SHOP_ID=
LINE_CHANNEL_ID=
LINE_DESTINATION_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Private internal API token. Generate a long random value; never put it in browser code.
INQUIRY_ADMIN_TOKEN=
LINE_BURST_WINDOW_MS=3000
LINE_MEDIA_MAX_BYTES=20971520
LINE_MEDIA_RETENTION_DAYS=30

# ---------- Admin workspace and Step 2 (server-only credentials) ----------
ADMIN_USERNAME=admin
# Use a separate random password of at least 16 characters for the admin login.
ADMIN_PASSWORD=
ADMIN_COOKIE_SECURE=false
# Complete Chat Completions endpoint of a dedicated extraction-only Hermes profile.
# Local dev example: http://127.0.0.1:8642/v1/chat/completions
# Docker on this server: bind Hermes to its private docker_gwbridge IP first.
HERMES_API_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_SECONDS=120

# ---------- LINE Login for the admin workspace (server .env only) ----------
# Create a LINE Login channel under the same provider as the OA's Messaging API channel.
# The redirect URI must exactly match the callback URL registered in LINE Developers,
# on the origin admins open. Production shares hermes.salepie.online with Hermes through Caddy
# path routing (docs/step-2-admin.md); keep ADMIN_COOKIE_SECURE=true there.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=https://hermes.salepie.online/api/admin/line/callback
# Comma-separated LINE user IDs allowed into the admin workspace. A denied login
# shows the user's ID so the owner can add it here. Removing an ID revokes its sessions.
# Leave ADMIN_PASSWORD empty to allow LINE Login only.
ADMIN_LINE_USER_IDS=

# ---------- Optional OA Manager browser connector on Ubuntu ----------
# Run build-oa-connector.bat on LOCAL; then deploy-oa-connector.sh on Ubuntu.
# Login control is bound only to Ubuntu loopback; use login-oa.bat over SSH.
# OA_BACKEND_URL=http://host.docker.internal:18080
# OA_CONTROL_HOST_PORT=18082
# OA_POLL_SECONDS=30
# OA_MEMORY=1g

# ---------- Production / Docker Swarm (set these in the .env ON THE SERVER) ----------
# docker-stack.yml builds MONGODB_URI from MONGO_USER + MONGO_PASSWORD, so the MONGODB_URI above is ignored there.
# Use letters and digits only so the same value works inside the URI, e.g.:  openssl rand -hex 24
# MONGO_USER=appuser
# MONGO_PASSWORD=change-me
# REGISTRY=                 # e.g. registry.example.com/team/   (must end with "/", only needed for multi-node Swarm)
# STACK=myapp               # Swarm stack name (defaults to APP_NAME)
# FRONTEND_PORT=18081       # admin frontend port for host Caddy
# ADMIN_COOKIE_SECURE=true  # production HTTPS; false only for local HTTP dev
# Frontend build URL: build-frontend.bat -BackendUrl http://backend:8080 (on LOCAL)

# ---------- Backend-only server deployment (deploy-line.sh) ----------
# LINE_HTTP_PORT=18080            # host port used by the existing Caddy reverse proxy
# SWARM_ADVERTISE_ADDR=           # server IP; required with --init-swarm
# Compile locally: build-backend.bat (build-line.bat alias), Docker Desktop Linux containers.
# Local concurrency: build-line.bat -Jobs 2. No Rust compiler is needed on Ubuntu.
