.git
.gitignore
.gitattributes

# Never bake secrets into an image
.env
.env.*

# Dependencies are excluded; allow only precompiled release inputs.
**/target
**/node_modules
**/.next
dist/*
!dist/line-linux/
data
billing_wth_text

# Not needed at build time
*.md
*.bat
prompts
docker-stack.yml
*.log

# Standalone output includes its traced runtime dependencies and static files.
!dist/frontend-linux/
!dist/frontend-linux/**
dist/frontend-linux/**/.env
dist/frontend-linux/**/.env.*

!dist/oa-connector-linux/
!dist/oa-connector-linux/**
dist/oa-connector-linux/**/.env
dist/oa-connector-linux/**/.env.*
