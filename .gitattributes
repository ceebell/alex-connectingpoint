# Normalize line endings. Windows scripts need CRLF, Linux scripts MUST be LF (CRLF breaks them on Ubuntu).
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Preserve the exact compiled Linux object and portable release metadata.
dist/line-linux/backend binary
dist/line-linux/backend.sha256 text eol=lf
dist/line-linux/release.tag text eol=lf
dist/line-linux/release.json text eol=lf
dist/frontend-linux/** -text
dist/oa-connector-linux/** -text
